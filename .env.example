# Copy to .env and fill in. .env is gitignored.
# In GitHub Actions these come from repo Secrets/vars, not this file.

# --- secrets ---
DISCORD_BOT_TOKEN=
ATPROTO_APP_PASSWORD=
SEMBLE_API_KEY=
# Mastodon: leave blank to keep the target OFF. Fill it (and set the GitHub secret)
# to go live. Token: sigmoid.social -> Preferences -> Development -> New application
# (scopes: write:statuses, write:media, write:accounts).
MASTODON_ACCESS_TOKEN=

# --- non-secret config ---
ATPROTO_HANDLE=colab-links.bsky.social
ATPROTO_PDS=https://bsky.social
SEMBLE_COLLECTION_IDS=065840e8-3d9c-4d1b-9f98-c200218a74ed
MASTODON_BASE_URL=https://sigmoid.social
DISCORD_CHANNEL_MATCH=papers-links-n-sharing
